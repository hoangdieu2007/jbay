<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1330.0" style="-fx-background-color: white;" styleClass="seller-item-root" stylesheets="@client-seller-item-style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="a88.jbay.controller.app.AuctionUI.ClientSellerItemController">
    <children>

        <HBox alignment="CENTER_LEFT" layoutX="0.0" layoutY="0.0" prefHeight="70.0" spacing="15.0" styleClass="seller-item-header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets left="20.0" right="30.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#handleBack" styleClass="btn-back" text="⬅ BACK" />
                <Label styleClass="header-title" text="Create / Edit Auction Item">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>

        <HBox alignment="CENTER" layoutX="0.0" layoutY="70.0" spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>

                <VBox alignment="CENTER" spacing="20.0" styleClass="card-panel" HBox.hgrow="NEVER">
                    <children>
                        <StackPane prefHeight="420.0" prefWidth="420.0" styleClass="image-dashed-container">
                            <children>
                                <ImageView fx:id="itemImageView" fitHeight="410.0" fitWidth="410.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </StackPane>
                        <Button mnemonicParsing="false" onAction="#handleUploadImage" prefHeight="45.0" prefWidth="250.0" styleClass="btn-general, btn-upload" text="📸 Upload Item Image" />
                    </children>
                </VBox>

                <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="section-title-large" text="Item Information">
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </Label>

                        <GridPane hgap="25.0" vgap="5.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <VBox prefHeight="69.0" prefWidth="304.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label styleClass="input-label" text="Item Name" />
                                    <TextField fx:id="nameField" prefHeight="42.0" promptText="Item Name..." styleClass="input-field" />
                                    <Label fx:id="nameErrorLabel" prefHeight="17.0" prefWidth="282.0" styleClass="error-label" text="Invalid Name" visible="false" />
                                </VBox>

                                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label styleClass="input-label" text="Starting Price (USD)" />
                                    <TextField fx:id="priceField" prefHeight="42.0" promptText="0.00" styleClass="input-field" />
                                    <Label fx:id="priceErrorLabel" prefHeight="17.0" prefWidth="302.0" styleClass="error-label" text="Invalid Price" visible="false" />
                                </VBox>

                                <VBox prefHeight="79.0" prefWidth="304.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label styleClass="input-label" text="Category Type" />
                                    <ComboBox fx:id="typeComboBox" prefHeight="42.0" prefWidth="1000.0" promptText="Choose item type" styleClass="input-field" />
                                    <Label fx:id="typeErrorLabel" prefHeight="17.0" prefWidth="301.0" styleClass="error-label" text="Invalid Type" visible="false" />
                                </VBox>

                                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label styleClass="input-label" text="Minimum Increment" />
                                    <TextField fx:id="minIncrementField" prefHeight="42.0" promptText="0.0" styleClass="input-field" />
                                    <Label fx:id="minIncrementErrorLabel" prefHeight="17.0" prefWidth="305.0" styleClass="error-label" text="Invalid Increment" visible="false" />
                                </VBox>

                                <VBox GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label styleClass="input-label" text="Start Time" />
                                    <HBox spacing="10.0">
                                        <ComboBox fx:id="startChoiceCombo" prefHeight="42.0" prefWidth="60.0" styleClass="input-field" />
                                        <TextField fx:id="startStr" prefHeight="42.0" promptText="dd/MM HH:mm" styleClass="input-field" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                    <Label fx:id="startErrorLabel" prefHeight="17.0" prefWidth="305.0" styleClass="error-label" text="Invalid Time" visible="false" />
                                </VBox>

                                <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label styleClass="input-label" text="Run Duration (Days)" />
                                    <HBox spacing="10.0">
                                        <ComboBox fx:id="runChoiceCombo" prefHeight="42.0" prefWidth="60.0" styleClass="input-field" />
                                        <TextField fx:id="runStr" prefHeight="42.0" promptText="Enter Auction Duration" styleClass="input-field" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                    <Label fx:id="endErrorLabel" prefHeight="17.0" prefWidth="305.0" styleClass="error-label" text="Invalid Duration" visible="false" />
                                </VBox>
                            </children>
                        </GridPane>

                        <VBox VBox.vgrow="ALWAYS">
                            <Label styleClass="input-label" text="Item Description" />
                            <TextArea fx:id="descriptionArea" promptText="Enter Item Description" styleClass="input-field" wrapText="true" VBox.vgrow="ALWAYS" />
                        </VBox>

                        <HBox alignment="CENTER_RIGHT" prefHeight="60.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleSubmit" prefHeight="45.0" prefWidth="250.0" styleClass="btn-general, btn-submit" text="🚀 Submit / Create Auction" />
                            </children>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>