<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="533.0" prefWidth="800.0" styleClass="qr-root" stylesheets="@qr-style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="a88.jbay.controller.app.AuctionUI.QRPaymentController">
    <children>

        <Label fx:id="lblSellerName" styleClass="seller-tag" text="👤 Seller: Duckie" StackPane.alignment="TOP_RIGHT">
            <StackPane.margin>
                <Insets right="20.0" top="20.0" />
            </StackPane.margin>
        </Label>

        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="450.0" prefWidth="400.0" spacing="20.0" styleClass="qr-card">
            <children>

                <VBox alignment="CENTER" spacing="4.0">
                    <children>
                        <Label styleClass="qr-title" text="Payment QR" />
                        <Label styleClass="qr-subtitle" text="Scan this code with your banking app" />
                    </children>
                </VBox>

                <StackPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="230.0" prefWidth="230.0" styleClass="qr-image-container">
                    <children>
                        <ImageView fx:id="qrImageView" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
                    </children>
                </StackPane>

                <StackPane VBox.vgrow="ALWAYS" />

                <Button fx:id="closeButton" mnemonicParsing="false" onAction="#handleClose" prefHeight="38.0" styleClass="btn-close" text="Done">
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Button>

            </children>
        </VBox>

    </children>
</StackPane>