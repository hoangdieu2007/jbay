<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #F4F7F9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="a88.jbay.controller.client.AdminController.AdminHomeScreenController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: linear-gradient(to right, #1E3A8A, #3B82F6); -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0);">
            <children>
                <Label fx:id="adminNameLabel" style="-fx-text-fill: white;" text="👤 UserName">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: rgba(255, 255, 255, 0.2); -fx-text-fill: white; -fx-background-radius: 20; -fx-border-color: white; -fx-border-radius: 20; -fx-font-weight: bold; -fx-padding: 8 25 8 25; -fx-cursor: hand;" text="LOG OUT" />
            </children>
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
        </HBox>
    </top>

    <center>
        <TabPane style="-fx-padding: 15; -fx-tab-min-width: 150;" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab style="-fx-font-weight: bold; -fx-font-size: 14;" text="User Management">
                    <content>
                        <VBox spacing="20.0" style="-fx-padding: 25; -fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <children>

                                <HBox alignment="BOTTOM_LEFT">
                                    <children>
                                        <VBox spacing="5.0">

                                            <children>
                                                <Label text="User Management" textFill="#1E293B">

                                                    <font>
                                                        <Font name="System Bold" size="28.0" />
                                                    </font>

                                                </Label>
                                                <Label text="Manage User status and control" textFill="#64748B">

                                                    <font>
                                                        <Font size="14.0" />

                                                    </font>
                                                </Label>

                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />

                                        <TextField fx:id="searchUserField" prefWidth="350.0" promptText="🔍 Searching user by user name..." style="-fx-background-radius: 10; -fx-padding: 10 15; -fx-border-color: #3B82F6; -fx-border-radius: 10; -fx-font-size: 14;" />
                                    </children>
                                </HBox>


                                <TableView fx:id="userTable" prefHeight="200.0" prefWidth="200.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-font-size: 16;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colUserId" prefWidth="112.0" text="ID" />

                                        <TableColumn fx:id="colUserName" prefWidth="491.0" text="User Name" />
                                        <TableColumn fx:id="colUserStatus" prefWidth="245.0" text="Status" />

                                        <TableColumn fx:id="colUserAction" prefWidth="350.0" text="Control" />
                                    </columns>
                                    <columnResizePolicy>

                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                            </children>
                        </VBox>
                    </content>
                </Tab>


                <Tab style="-fx-font-weight: bold; -fx-font-size: 14;" text="Auction Management">
                    <content>
                        <VBox spacing="20.0" style="-fx-padding: 25; -fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <children>
                                <HBox alignment="BOTTOM_LEFT">

                                    <children>
                                        <VBox spacing="5.0">
                                            <children>

                                                <Label text="Auction Management" textFill="#1E293B">
                                                    <font>
                                                        <Font name="System Bold" size="28.0" />
                                                    </font>
                                                </Label>

                                                <Label text="Manage Auction status and control" textFill="#64748B">
                                                    <font>
                                                        <Font size="14.0" />
                                                    </font>

                                                </Label>
                                            </children>

                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="searchAuctionField" prefWidth="350.0" promptText="🔍 Searching auction by item name..." style="-fx-background-radius: 10; -fx-padding: 10 15; -fx-border-color: #3B82F6; -fx-border-radius: 10; -fx-font-size: 14;" />
                                    </children>
                                </HBox>

                                <TableView fx:id="auctionTable" prefHeight="200.0" prefWidth="200.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-font-size: 16;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colAuctionId" prefWidth="112.0" text="ID" />

                                        <TableColumn fx:id="colAuctionTitle" prefWidth="486.0" text="Item Name" />
                                        <TableColumn fx:id="colAuctionStatus" prefWidth="250.0" text="Status" />

                                        <TableColumn fx:id="colAuctionAction" prefWidth="350.0" text="Control" />
                                    </columns>
                                    <columnResizePolicy>

                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>

        </TabPane>
    </center>
</BorderPane>
