<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" fillWidth="false" prefHeight="482.0" prefWidth="300.0" spacing="10.0" style="-fx-border-color: #ccc; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="a88.jbay.controller.client.SellerItemCardController">
    <children>
        <ImageView fx:id="sellerImage" fitHeight="230.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
         <VBox.margin>
            <Insets />
         </VBox.margin></ImageView>

        <HBox alignment="CENTER_LEFT" prefHeight="22.0" prefWidth="298.0" spacing="10.0">
            <children>
                <Label fx:id="lblName" prefHeight="26.0" text="ItemName" HBox.hgrow="ALWAYS">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
                <Region prefHeight="26.0" prefWidth="96.0" />
                <Label fx:id="lblStatus" style="-fx-background-color: #D1FAE5; -fx-text-fill: #065F46; -fx-padding: 3 8; -fx-background-radius: 5;" text="Status" />
            </children>
            <padding>
                <Insets left="15.0" />
            </padding>
        </HBox>
        <HBox prefHeight="56.0" prefWidth="298.0">
            <children>
                <Label minHeight="-Infinity" minWidth="-Infinity" prefHeight="56.0" text="Highest Bid" textFill="#dd2121">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                    <HBox.margin>
                        <Insets />
                    </HBox.margin>
                </Label>
                <Region prefHeight="56.0" prefWidth="91.0" />
                <Label fx:id="lblPrice" alignment="CENTER" prefHeight="76.0" prefWidth="98.0" text="Price" textAlignment="CENTER">
                    <font>
                        <Font size="20.0" />
                    </font>
                </Label>
            </children>
         <padding>
            <Insets left="15.0" />
         </padding>
        </HBox>
        <HBox prefHeight="50.0" prefWidth="298.0">
            <children>
                <Label minWidth="-Infinity" prefHeight="66.0" text="Top Bidder">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <Region prefHeight="50.0" prefWidth="71.0" />
                <Label fx:id="lblHighestBidderName" alignment="CENTER" prefHeight="50.0" prefWidth="148.0" text="BidderName" textAlignment="CENTER">
                    <font>
                        <Font size="20.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets left="15.0" />
            </padding>
        </HBox>
      <HBox alignment="CENTER" prefHeight="59.0" prefWidth="298.0">
         <children>
            <Button alignment="CENTER" mnemonicParsing="false" prefHeight="40.0" prefWidth="108.0" style="-fx-background-color: Red; -fx-text-fill: White; -fx-background-radius: 120;" text="Cancel">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
            <Region prefHeight="59.0" prefWidth="44.0" />
            <Button alignment="CENTER" mnemonicParsing="false" prefHeight="40.0" prefWidth="108.0" style="-fx-background-color: #2b5fe8; -fx-text-fill: white; -fx-background-radius: 120;" text="View" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
         </children>
      </HBox>
    </children>
</VBox>
