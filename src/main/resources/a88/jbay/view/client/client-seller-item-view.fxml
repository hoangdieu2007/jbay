<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #F4F7F9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="a88.jbay.controller.client.ClientSellerItemController">

   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" style="-fx-background-color: linear-gradient(to right, #1E3A8A, #3B82F6); -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0);" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="20.0" right="30.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: rgba(255, 255, 255, 0.2); -fx-text-fill: white; -fx-background-radius: 20; -fx-border-color: white; -fx-border-radius: 20; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;" text="⬅ BACK" />
            <Label style="-fx-text-fill: white;" text="Create / Edit Auction Item">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
            </Label>
         </children>
      </HBox>
   </top>

   <center>
      <HBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </padding>
         <children>

            <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 30;" HBox.hgrow="NEVER">
               <children>
                  <StackPane prefHeight="420.0" prefWidth="420.0" style="-fx-border-color: #CBD5E1; -fx-border-style: dashed; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-color: #F8FAFC; -fx-background-radius: 10;">
                     <children>
                        <ImageView fx:id="itemImageView" fitHeight="410.0" fitWidth="410.0" pickOnBounds="true" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <Button mnemonicParsing="false" onAction="#handleUploadImage" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;" text="📸 Upload Item Image">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Button>
               </children>
            </VBox>

            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 30;" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Item Information" textFill="#1E293B">
                     <font>
                        <Font name="System Bold" size="26.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Label>

                  <GridPane hgap="25.0" vgap="5.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>

                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                           <Label text="Item Name" textFill="#64748B"><font><Font name="System Bold" size="14.0" /></font></Label>
                           <TextField fx:id="nameField" prefHeight="42.0" promptText="Item Name..." style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-font-size: 14;" />
                           <Label fx:id="nameErrorLabel" prefHeight="17.0" prefWidth="146.0" text="Invalid Name" textFill="#EF4444" visible="false"><font><Font size="12.0" /></font></Label>
                        </VBox>

                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                           <Label text="Starting Price (USD)" textFill="#64748B"><font><Font name="System Bold" size="14.0" /></font></Label>
                           <TextField fx:id="priceField" prefHeight="42.0" promptText="0.00" style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-font-size: 14;" />
                           <Label fx:id="priceErrorLabel" prefHeight="17.0" prefWidth="201.0" text="Invalid Price" textFill="#EF4444" visible="false"><font><Font size="12.0" /></font></Label>
                        </VBox>

                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="1">
                           <Label text="Category Type" textFill="#64748B"><font><Font name="System Bold" size="14.0" /></font></Label>
                           <ComboBox fx:id="typeComboBox" prefHeight="42.0" prefWidth="1000.0" promptText="Choose item type" style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-color: white; -fx-font-size: 14;" />
                           <Label fx:id="typeErrorLabel" prefHeight="17.0" prefWidth="162.0" text="Invalid Type" textFill="#EF4444" visible="false"><font><Font size="12.0" /></font></Label>
                        </VBox>

                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <Label text="Start Time" textFill="#64748B"><font><Font name="System Bold" size="14.0" /></font></Label>
                           <HBox spacing="10.0">
                              <ComboBox fx:id="startChoiceCombo" prefHeight="32.0" prefWidth="45.0" style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-color: white; -fx-font-size: 14;" />
                              <TextField fx:id="startStr" prefHeight="42.0" promptText="dd/MM HH:mm" style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-font-size: 14;" HBox.hgrow="ALWAYS" />
                           </HBox>
                           <Label fx:id="startErrorLabel" prefHeight="17.0" prefWidth="148.0" text="Invalid Time" textFill="#EF4444" visible="false"><font><Font size="12.0" /></font></Label>
                        </VBox>

                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="2">
                           <Label text="Run Duration (Days)" textFill="#64748B"><font><Font name="System Bold" size="14.0" /></font></Label>
                           <HBox spacing="10.0">
                              <ComboBox fx:id="runChoiceCombo" prefHeight="32.0" prefWidth="45.0" style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-color: white; -fx-font-size: 14;" />
                              <TextField fx:id="runStr" prefHeight="32.0" prefWidth="166.0" promptText="Enter Auction Duration" style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-font-size: 14;" HBox.hgrow="ALWAYS" />
                           </HBox>
                           <Label fx:id="endErrorLabel" prefHeight="17.0" prefWidth="196.0" text="Invalid Duration" textFill="#EF4444" visible="false"><font><Font size="12.0" /></font></Label>
                        </VBox>
                     </children>
                  </GridPane>

                  <VBox VBox.vgrow="ALWAYS">
                     <Label text="Item Description" textFill="#64748B"><font><Font name="System Bold" size="14.0" /></font></Label>
                     <TextArea fx:id="descriptionArea" promptText="Enter Item Description" style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-font-size: 14;" wrapText="true" VBox.vgrow="ALWAYS" />
                  </VBox>

                  <HBox alignment="CENTER_RIGHT" prefHeight="60.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleSubmit" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;" text="🚀 Submit / Create Auction">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </HBox>

               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>
